# --- Database ---------------------------------------------------------
# Local dev default (SQLite, file-based). For production, point this at
# Postgres instead — e.g.:
#   DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname
# No code changes are required to switch; SQLAlchemy handles both.
DATABASE_URL=sqlite:///activity_tracker.db

# --- Composio (email notifications) ------------------------------------
COMPOSIO_API_KEY=
# The Composio user_id / connected-account owner that has an authenticated
# Gmail (or other email toolkit) connection set up in Composio.
COMPOSIO_CONNECTED_ACCOUNT_ID=
NOTIFICATION_EMAIL_TO=alerts@chalo.com
NOTIFICATION_EMAIL_FROM=activity-tracker@chalo.com

# --- Scheduler -----------------------------------------------------------
# Interval in minutes between scrape runs. Examples: 60 = hourly, 1440 = daily.
SCRAPE_INTERVAL_MINUTES=60
# Whether to run one pipeline pass immediately on process startup, in
# addition to the recurring schedule.
RUN_SCRAPE_ON_STARTUP=true

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO

# --- Keywords ----------------------------------------------------------------
# Path to the keyword list. Defaults to keywords.csv at the project root.
KEYWORDS_CSV_PATH=keywords.csv

# --- Scraper behaviour -----------------------------------------------------
REQUEST_TIMEOUT_SECONDS=20
REQUEST_USER_AGENT=Mozilla/5.0 (compatible; ChaloActivityTracker/1.0; +https://chalo.com)
MAX_ARTICLES_PER_SCRAPE=50
